---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pathSlug?: string;
  canonicalSlug?: string;
  rawPath?: string;
  ogImageAlt?: string;
  versionLabel?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  pathSlug = '',
  canonicalSlug,
  rawPath = 'raw/SPEC.md',
  ogImageAlt = 'zBTC Interoperability Protocol Specification — Tier F Taproot HSM custody, direct-on-L1 SPV, feeless lattice, Bitcoin.',
  versionLabel = '3.0.0-rfc',
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const normalizedSlug = (canonicalSlug ?? pathSlug).replace(/^\/+/, '');
const canonical = new URL(`${base}${normalizedSlug}`, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
const llmsTxt = new URL(`${base}llms.txt`, Astro.site).href;
const rawUrl = new URL(`${base}${rawPath}`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: title,
  description,
  url: canonical,
  image: ogImage,
  version: versionLabel,
  inLanguage: 'en-US',
  isAccessibleForFree: true,
  author: {
    '@type': 'Organization',
    name: 'btc-moonshot',
    url: 'https://github.com/btc-moonshot',
  },
  publisher: {
    '@type': 'Organization',
    name: 'btc-moonshot',
    url: 'https://github.com/btc-moonshot/spec',
  },
  codeRepository: 'https://github.com/btc-moonshot/spec',
  keywords: [
    'Bitcoin',
    'Taproot',
    'OP_CHECKSIGADD',
    'zBTC',
    'Zenon',
    'SPV',
    'PTLC',
    'Lightning Network',
    'Feeless Payments',
    'Protocol Specification',
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large'}
    />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="text/markdown" title="Raw Markdown" href={rawUrl} />
    <link rel="alternate" type="text/plain" title="LLMs Manifest (llms.txt)" href={llmsTxt} />
    <meta name="theme-color" content="#f3f0e6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Bitcoin payments moonshot — Spec" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured Data for Search Engines & LLMs -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Apply saved theme before first paint to avoid flash -->
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#article">Skip to specification</a>
    <slot />
  </body>
</html>
