---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/05-go-zenon-upgrade-plan.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-05"
  version="v1"
  title={spec.title}
  description="Part 5: Stage 0 go-zenon prerequisites (0aa299e, #239 FIFO panic-stall closure, DynamicPlasmaSpork + full SetPlasmaVariables pinning, PtlcSpork, SPV oracle) and Stage 1A/1B zero-hard-fork custody isolation."
  pathSlug="part-05/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 4: Zenon 49% Consensus Boundary, Inverted Trust Hierarchy & Light Clients', href: `${base}part-04/` }}
  next={{ label: 'Consistency & Bounds Checker', href: `${base}oracle/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
