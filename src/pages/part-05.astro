---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/05-go-zenon-upgrade-plan.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-05"
  version="v1"
  title={spec.title}
  description="Part 5: go-zenon upgrade plan targeting first release containing 0aa299e, DynamicPlasmaSpork precondition + 2.1M floor (B2), #239 FIFO receive gate (B1), TreasuryTrancheEscrow, and U5 governance."
  pathSlug="part-05/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 4: Bitcoin Anchoring & Light Client Infrastructure', href: `${base}part-04/` }}
  next={{ label: 'Consistency & Bounds Checker', href: `${base}oracle/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
