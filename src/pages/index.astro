---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const spec = renderSpecFile('SPEC.md', 'v1');
const diffBundle = buildV1ToV0Diff('SPEC.md');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="index"
  version="v1"
  title={spec.title}
  pageTitle="zBTC: Bitcoin–Zenon Interoperability Protocol Specification (v1 / v3.0.0-rfc)"
  description="Public RFC v1 (v3.0.0-rfc): Tier F honest capped Taproot OP_CHECKSIGADD HSM federation, direct-on-L1 trimmed Bitcoin SPV, tranche-isolated feeless zBTC, and peg-free PTLC/LN rails."
  pathSlug=""
  rawPath="raw/SPEC.md"
  dek="Normative master specification (Tier F), Privileged Powers Table, honest threat model, written R7 Q&A, and v2 trust-minimized research roadmap."
  toc={spec.toc}
  diffBundle={diffBundle}
  next={{ label: 'Part 1: Bitcoin Federated Custody (BTC-CUSTODY-F1)', href: `${base}part-01/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
