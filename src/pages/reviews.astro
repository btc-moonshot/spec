---
import SpecShell from '../components/SpecShell.astro';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const toc = [
  { id: 'convergence', label: 'Adversarial Audit History (R1–R7)', level: 2 as const },
  { id: 'r7-pivot', label: 'Consolidated Hostile Review (R7) → Zero-Federation v1 Pivot', level: 2 as const },
  { id: 'raw-reports', label: 'Full Unedited Review Reports (R1–R7)', level: 2 as const },
  { id: 'open-gates', label: 'Blocking Gates Before Mainnet', level: 2 as const },
];
---

<SpecShell
  activeKey="reviews"
  version="v1"
  title="Adversarial Review Audit Trail (Rounds 1–7)"
  description="Complete transparent record of adversarial peer reviews on the zBTC specification, including Consolidated Hostile Review R7 and the resulting v0 → v1 zero-federation phased redesign."
  pathSlug="reviews/"
  rawPath="raw/reviews/HOSTILE_REVIEW_R7_CONSOLIDATED.md"
  dek="Every version of this specification is audited adversarially and published unedited below — including the R7 NO-GO audit of v0 that triggered the zero-federation v1 redesign."
  toc={toc}
  prev={{ label: 'Changelog (v0 → v1)', href: `${base}changelog/` }}
  next={{ label: 'How to Review, File Issues & Open PRs', href: `${base}review-guide/` }}
>
  <h2 id="convergence">Adversarial Audit History (Rounds 1–7)</h2>
  <p>
    Rounds 1–6 hardened internal arithmetic and state-machine consistency on the <code>v0</code> (<code>v2.5.0-rfc</code>)
    BitVM2 + PoS-committee hybrid. Consolidated Hostile Review <strong>R7</strong> (Nov 26, 2026) then attacked the
    underlying premises (ZNN market cap, BitVM2 Groth16 script weights, committee-signed canonical state, and
    never-deleted <code>Q_graph</code>), returning <code>NO-GO</code>.
  </p>
  <p>
    <strong><code>v1 (v3.0.0-rfc)</code> resolves every <code>R7</code> blocker while explicitly rejecting
    <code>R7</code>'s federated multisig fallback:</strong> custodial <code>k</code>-of-<code>n</code> signers violate
    non-custodial Bitcoin ethos and fail zero-signer unilateral recovery. Instead, <code>v1</code> adopts a
    <strong>Zero-Federation Phased Architecture</strong> starting with <strong>Stage 0 Verify Bitcoin</strong>
    (SPV Event Oracle + non-custodial PTLC/LN swaps, zero bridge custody), followed by an explicit capital &amp;
    maturity gate between <strong>Stage 1A Right-Sized <code>BitVMX</code> (<code>n = 8</code>, 100% TRUC v3) +
    Bitcoin-Anchored Sovereign ZK Validity Rollup</strong> (<code>0-of-N</code> Zenon trust, surviving 49%–100% Zenon
    compromise) and <strong>Stage 1B <code>clArk</code> VTXOs</strong>.
  </p>

  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Round</th>
          <th>Spec Version</th>
          <th>Verdict</th>
          <th style="text-align:right">Critical</th>
          <th style="text-align:right">High</th>
          <th style="text-align:right">Medium</th>
          <th style="text-align:right">Low</th>
          <th>Report</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>R1–R5</strong></td>
          <td><code>v1.0</code> – <code>v2.3</code></td>
          <td><code>REJECT</code> / <code>HOLD</code></td>
          <td style="text-align:right">12 &rarr; 0</td>
          <td style="text-align:right">12 &rarr; 3</td>
          <td style="text-align:right">15 &rarr; 4</td>
          <td style="text-align:right">10 &rarr; 9</td>
          <td><a href={`${base}raw/reviews/HOSTILE_REVIEW_R1.md`}>R1</a>–<a href={`${base}raw/reviews/HOSTILE_REVIEW_R5.md`}>R5</a></td>
        </tr>
        <tr>
          <td><strong>R6</strong></td>
          <td><code>v2.4.0-draft</code></td>
          <td><code>HOLD</code></td>
          <td style="text-align:right">0</td>
          <td style="text-align:right">2</td>
          <td style="text-align:right">5</td>
          <td style="text-align:right">9</td>
          <td><a href={`${base}raw/reviews/HOSTILE_REVIEW_R6.md`}>R6.md</a></td>
        </tr>
        <tr>
          <td><strong>R7 (Consolidated)</strong></td>
          <td><a href={`${base}v0/`}><code>v0</code> (<code>v2.5.0-rfc</code>)</a></td>
          <td><strong><code>NO-GO</code></strong></td>
          <td style="text-align:right"><strong>4</strong></td>
          <td style="text-align:right"><strong>8</strong></td>
          <td style="text-align:right"><strong>15</strong></td>
          <td style="text-align:right"><strong>4</strong></td>
          <td><a href={`${base}raw/reviews/HOSTILE_REVIEW_R7_CONSOLIDATED.md`}>R7.md</a></td>
        </tr>
        <tr>
          <td><strong>v1 Zero-Federation Redesign</strong></td>
          <td><a href={`${base}`}><strong><code>v1</code> (<code>v3.0.0-rfc</code>)</strong></a></td>
          <td><strong>Open for Independent Review</strong></td>
          <td colspan="4">All R7 findings dispositioned without federated multisigs; Stage 0 &rarr; Stage 1A <code>BitVMX</code> | Stage 1B <code>clArk</code></td>
          <td><a href={`${base}changelog/`}>Changelog</a></td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2 id="r7-pivot">Consolidated Hostile Review (<code>R7</code>) &rarr; Zero-Federation <code>v1</code> Pivot</h2>
  <p>
    See the complete finding-by-finding table and word-level file diffs on the
    <a href={`${base}changelog/`}><strong>Changelog (v0 &rarr; v1)</strong></a> page, or inspect the archived
    byte-for-byte <a href={`${base}v0/`}><code>v0 (v2.5.0-rfc)</code></a> baseline directly.
  </p>

  <h2 id="raw-reports">Full Unedited Review Reports (R1–R7)</h2>
  <ul>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R7_CONSOLIDATED.md`}>HOSTILE_REVIEW_R7_CONSOLIDATED.md</a> — Consolidated hostile review of <code>v0</code> (<code>v2.5.0-rfc</code>) (4 C / 8 H / 15 M / 4 L; <code>NO-GO</code>)</li>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R6.md`}>HOSTILE_REVIEW_R6.md</a> — <code>v2.4.0-draft</code> audit</li>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R5.md`}>HOSTILE_REVIEW_R5.md</a> — <code>v2.3</code> audit</li>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R4.md`}>HOSTILE_REVIEW_R4.md</a> — <code>v2.2</code> audit</li>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R3.md`}>HOSTILE_REVIEW_R3.md</a> — <code>v2.1</code> audit</li>
    <li><a href={`${base}raw/reviews/HOSTILE_REVIEW_R2.md`}>HOSTILE_REVIEW_R2.md</a> — <code>v2.0</code> audit</li>
