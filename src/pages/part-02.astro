---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/02-btc-authorization-domain-and-spv.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-02"
  version="v1"
  title={spec.title}
  description="Part 2: Stage 0 panic-recovered direct-on-L1 Bitcoin SPV Event Oracle (1-/2-block coinbase midstate proof, B2 Plasma floor) and Stage 1A Bitcoin L1 DA, canonical ordering, forced-inclusion inbox (0x00..0x07), and TVL-scaled K."
  pathSlug="part-02/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 1: Zero-Federation Bitcoin Custody Enforcement (BitVMX & clArk)', href: `${base}part-01/` }}
  next={{ label: 'Part 3: Sovereign Rollup STF, Feeless Zenon Sequencer & PTLC/LN Rails', href: `${base}part-03/` }}
>
  <div class="spec-body" set:html={spec.html} />
