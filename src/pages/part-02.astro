---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/02-btc-authorization-domain-and-spv.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-02"
  version="v1"
  title={spec.title}
  description="Part 2: Direct-on-L1 panic-recovered Bitcoin SPV verifier (vm/embedded/btcspv), coinbase midstate proof, sweep lock & conflict-only refund verification, and B2 Dynamic Plasma floor."
  pathSlug="part-02/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 1: Bitcoin Federated Custody (BTC-CUSTODY-F1)', href: `${base}part-01/` }}
  next={{ label: 'Part 3: Lightweight Settlement & Peg-Free Rails', href: `${base}part-03/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
