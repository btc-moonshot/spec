---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/04-bitcoin-anchoring-and-light-client.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-04"
  version="v1"
  title={spec.title}
  description="Part 4: Code-grounded proof of Zenon 49% DPoS and >33.3% BFT failure bounds, the inverted Bitcoin-L1-first trust hierarchy (0-of-N Zenon trust surviving 49%-100% Zenon compromise), and optional non-custodial light-client infrastructure."
  pathSlug="part-04/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 3: Sovereign Rollup STF, Feeless Zenon Sequencer & PTLC/LN Rails', href: `${base}part-03/` }}
  next={{ label: 'Part 5: go-zenon Prerequisites & Zero-Hard-Fork Custody Plan', href: `${base}part-05/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
