---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/04-bitcoin-anchoring-and-light-client.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-04"
  version="v1"
  title={spec.title}
  description="Part 4: Non-custodial Zenon history anchoring & light client infrastructure (H-1 epoch-averaged slashable/beacon committee, L-1 edge cases, N-1 quorum-only impairment, H-7 mandatory handoff anchoring)."
  pathSlug="part-04/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 3: Lightweight Settlement & Peg-Free Rails', href: `${base}part-03/` }}
  next={{ label: 'Part 5: Detailed go-zenon Node Upgrade Plan', href: `${base}part-05/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
