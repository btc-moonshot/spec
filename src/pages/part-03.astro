---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/03-settlement-minted-zbtc-and-feeless-rails.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-03"
  version="v1"
  title={spec.title}
  description="Part 3: Lightweight SettlementContract, TreasuryTrancheEscrow cap isolation (H-8/B3c), BatchIntent & conflict refunds (B4), Dynamic Plasma budget at 11.4s Momentums, and hardened PTLC/LN rails (M-4)."
  pathSlug="part-03/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 2: Direct-on-L1 Trimmed Bitcoin SPV', href: `${base}part-02/` }}
  next={{ label: 'Part 4: Bitcoin Anchoring & Light Client Infrastructure', href: `${base}part-04/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
