---
import fs from 'node:fs';
import path from 'node:path';
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff } from '../lib/spec';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const scriptSrc = fs.readFileSync(path.join(process.cwd(), 'scripts/verify_spec_bounds.py'), 'utf-8');
const oracleOutput = fs.readFileSync(path.join(process.cwd(), 'public/raw/oracle-output.txt'), 'utf-8');
const diffBundle = buildV1ToV0Diff('scripts/verify_spec_bounds.py');

const toc = [
  { id: 'run-locally', label: 'Run Locally', level: 2 as const },
  { id: 'verified-output', label: 'Verified Output (v1 / v3.0.0-rfc)', level: 2 as const },
  { id: 'checker-source', label: 'Checker Source (verify_spec_bounds.py)', level: 2 as const },
];
---

<SpecShell
  activeKey="oracle"
  version="v1"
  title="Deterministic Consistency & Bounds Checker"
  description="Zero-dependency Python 3 consistency checker verifying Stage 0 coinbase midstate padding, honest 8 MiB Plasma throughput & PTLC 2.3x margins, Stage 1A n=8 BitVMX TRUC v3 weights, Lamport TakeTx, positive-EV verifier matrix, bank-run math, halving-indexed K, a non-no-op 2,000-step state-machine & reorg simulation, and Stage 1B clArk bounds."
  pathSlug="oracle/"
  rawPath="raw/scripts/verify_spec_bounds.py"
  dek="Checks internal mathematical consistency against explicitly labeled SOURCED_, POLICY_, and PRE_MAINNET_TARGET_ inputs — not a substitute for Signet execution or independent audits."
  toc={toc}
  diffBundle={diffBundle}
  prev={{ label: 'Part 5: go-zenon Prerequisites & Zero-Hard-Fork Custody Plan', href: `${base}part-05/` }}
  next={{ label: 'Changelog (v0 → v1)', href: `${base}changelog/` }}
>
  <h2 id="run-locally">Run Locally</h2>
  <p>
    Requires only standard-library Python 3 (zero external dependencies). GitHub Actions CI executes both this checker
    and the archived <code>v0</code> oracle on every pull request:
  </p>
  <pre><code>python3 -I scripts/verify_spec_bounds.py</code></pre>
  <p>
    Download raw source: <a href={`${base}raw/scripts/verify_spec_bounds.py`}>verify_spec_bounds.py</a> ·
    <a href={`${base}raw/oracle-output.txt`}>oracle-output.txt</a> ·
    <a href={`${base}v0/oracle/`}>archived v0 oracle</a>.
  </p>

  <h2 id="verified-output">Verified Output (v1 / v3.0.0-rfc)</h2>
  <pre><code>{oracleOutput}</code></pre>

  <h2 id="checker-source">Checker Source (verify_spec_bounds.py)</h2>
  <pre><code>{scriptSrc}</code></pre>
</SpecShell>
