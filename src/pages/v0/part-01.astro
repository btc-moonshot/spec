---
import SpecShell from '../../components/SpecShell.astro';
import { renderSpecFile } from '../../lib/spec';

const rel = 'spec/01-bitcoin-taproot-vault-enforcement.md';
const spec = renderSpecFile(rel, 'v0');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-01"
  version="v0"
  title={spec.title}
  pageTitle={`${spec.title} — Archived v0 (v2.5.0-rfc)`}
  description="Archived v0 (v2.5.0-rfc) Part 1 snapshot frozen byte-for-byte from commit 7b47b8c. Superseded by v1 (v3.0.0-rfc)."
  pathSlug="v0/part-01/"
  canonicalSlug="part-01/"
  rawPath={`raw/v0/${rel}`}
  toc={spec.toc}
  prev={{ label: 'Master Overview (v0)', href: `${base}v0/` }}
  next={{ label: 'Part 2 (v0): Bitcoin Authorization Domain & SPV', href: `${base}v0/part-02/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
