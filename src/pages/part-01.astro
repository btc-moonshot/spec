---
import SpecShell from '../components/SpecShell.astro';
import { renderSpecFile } from '../lib/spec';

const spec = renderSpecFile('spec/01-bitcoin-taproot-vault-enforcement.md');
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-01"
  title={spec.title}
  description="Part 1 (BTC-ENFORCEMENT-V1): 4-key registry, per-block OP_HASH160 W-OTS BLS12-381 cert DA, Leaf-3B SHA-256 without OP_CAT, staggered 46d/56d/58d CLTVs, 30-day rotation, and integer-satoshi BitVM2 economics."
  pathSlug="part-01/"
  rawPath="raw/spec/01-bitcoin-taproot-vault-enforcement.md"
  toc={spec.toc}
  prev={{ label: 'Master Overview (SPEC.md)', href: `${base}` }}
  next={{ label: 'Part 2: Bitcoin Authorization Domain & SPV', href: `${base}part-02/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
