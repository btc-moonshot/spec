---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/01-bitcoin-taproot-vault-enforcement.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-01"
  version="v1"
  title={spec.title}
  description="Part 1 (BTC-CUSTODY-F1): Taproot NUMS + OP_CHECKSIGADD HSM federation, 52,560-block recovery leaf, dual-implementation B3a/B3b signer policy, Proof-of-Reserves, Wind-Down loss model, and v2 BitVM Research Annex."
  pathSlug="part-01/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Master Overview (SPEC.md)', href: `${base}` }}
  next={{ label: 'Part 2: Direct-on-L1 Trimmed Bitcoin SPV', href: `${base}part-02/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
