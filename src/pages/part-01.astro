---
import SpecShell from '../components/SpecShell.astro';
import { buildV1ToV0Diff, renderSpecFile } from '../lib/spec';

const rel = 'spec/01-bitcoin-taproot-vault-enforcement.md';
const spec = renderSpecFile(rel, 'v1');
const diffBundle = buildV1ToV0Diff(rel);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SpecShell
  activeKey="part-01"
  version="v1"
  title={spec.title}
  description="Part 1 (BTC-BITVMX-V1): Zero-Federation Bitcoin Taproot Vault Enforcement — Stage 0 zero-custody baseline, Stage 1A right-sized BitVMX-CPU (n=8, 100% BIP-431 TRUC v3) deleted-key {0.50, 0.25, 0.25} BTC vaults & dual-input slashing, Stage 1B clArk gate, and Track B soft-fork annex."
  pathSlug="part-01/"
  rawPath={`raw/${rel}`}
  toc={spec.toc}
  diffBundle={diffBundle}
  prev={{ label: 'Master Overview (SPEC.md)', href: `${base}` }}
  next={{ label: 'Part 2: Stage 0 SPV Event Oracle & Stage 1A L1 DA / Forced Inbox', href: `${base}part-02/` }}
>
  <div class="spec-body" set:html={spec.html} />
</SpecShell>
