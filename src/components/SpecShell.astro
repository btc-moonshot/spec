---
import Base from '../layouts/Base.astro';
import { SPEC_NAV, type TocItem } from '../lib/spec';

interface Props {
  activeKey: string;
  title: string;
  pageTitle?: string;
  description: string;
  pathSlug?: string;
  rawPath?: string;
  dek?: string;
  toc: TocItem[];
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
}

const {
  activeKey,
  title,
  pageTitle = `${title} — zBTC Protocol Specification`,
  description,
  pathSlug = '',
  rawPath = 'raw/SPEC.md',
  dek,
  toc,
  prev,
  next,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const REPO = 'https://github.com/btc-moonshot/spec';
const ISSUES = `${REPO}/issues/new/choose`;
const PRS = `${REPO}/pulls`;
---

<Base title={pageTitle} description={description} pathSlug={pathSlug} rawPath={rawPath}>
  <div class="page">
    <header class="masthead">
      <a class="kicker" href={base}>~/bitcoin-payments/spec</a>
      <div class="masthead-right">
        <a class="meta-link" href={`${base}llms.txt`}>[llms.txt]</a>
        <a class="meta-link" href={REPO} target="_blank" rel="noopener noreferrer">[github]</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <span class="t-to-dark">[dark]</span><span class="t-to-light">[light]</span>
        </button>
      </div>
    </header>

    <nav class="part-nav" aria-label="Specification modules">
      <div class="part-nav-inner">
        {SPEC_NAV.map((item) => (
          <a href={item.href} class:list={['part-tab', { active: item.key === activeKey }]}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="layout">
      <aside class="toc" aria-label="Table of contents">
        <details open id="toc-details">
          <summary>
            <span class="toc-heading">Contents</span>
            <span class="toc-current" id="toc-current"></span>
          </summary>
          <ol>
            {toc.map((item) => (
              <li class:list={[{ sub: item.level === 3 }]}>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
          <div class="toc-agent-box">
            <p class="toc-box-title">// agent &amp; raw links</p>
            <ul>
              <li><a href={`${base}${rawPath}`}>raw source ({rawPath.split('/').pop()})</a></li>
              <li><a href={`${base}llms.txt`}>llms.txt (review guide)</a></li>
              <li><a href={`${base}llms-full.txt`}>llms-full.txt (1-fetch)</a></li>
              <li><a href={ISSUES} target="_blank" rel="noopener noreferrer">open finding / issue</a></li>
              <li><a href={PRS} target="_blank" rel="noopener noreferrer">submit a PR</a></li>
            </ul>
          </div>
        </details>
      </aside>

      <main class="article" id="article">
        <article>
          <header class="article-header">
            <p class="rfc-badge">v2.5.0-rfc · public review · oracle verified · not mainnet-active</p>
            <h1>{title}</h1>
            {dek && <p class="dek">{dek}</p>}
          </header>

          <slot />

          {(prev || next) && (
            <nav class="pager" aria-label="Chapter navigation">
              <div>{prev && <a href={prev.href}>&larr; {prev.label}</a>}</div>
              <div>{next && <a href={next.href}>{next.label} &rarr;</a>}</div>
            </nav>
          )}

          <section class="cta" aria-labelledby="review-cta">
            <h2 id="review-cta">Attack this spec &amp; submit feedback</h2>
            <p>
              This is a <strong>Public RFC</strong> refined across 6 adversarial review rounds. Humans and AI review
              agents are invited to verify <code>python3 -I scripts/verify_spec_bounds.py</code>, test invariants, file
              findings, or open pull requests.
            </p>
            <div class="cta-actions">
              <a class="cta-button" href={ISSUES} target="_blank" rel="noopener noreferrer">Open an Issue</a>
              <a class="cta-ghost" href={`${base}review-guide/`}>Review &amp; PR Guide</a>
              <a class="cta-ghost" href={`${base}llms.txt`}>Read llms.txt</a>
              <a class="cta-ghost" href={`${base}llms-full.txt`}>Fetch llms-full.txt</a>
            </div>
          </section>
        </article>
      </main>
    </div>

    <footer class="site-footer">
      <p>
        zBTC Interoperability Specification (`v2.5.0-rfc`) ·
        <a href={REPO} target="_blank" rel="noopener noreferrer">github.com/btc-moonshot/spec</a> ·
        <a href={`${base}llms.txt`}>llms.txt</a> ·
        <a href={`${base}oracle/`}>bounds oracle</a>
      </p>
    </footer>
  </div>
</Base>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');

  function currentTheme() {
    const t = root.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return darkQuery.matches ? 'dark' : 'light';
  }

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const details = document.getElementById('toc-details') as HTMLDetailsElement | null;
  const desktop = matchMedia('(min-width: 1160px)');
  function syncToc() {
    if (!details) return;
    details.open = desktop.matches;
  }
  syncToc();
  desktop.addEventListener('change', syncToc);

  const tocLinks = [...document.querySelectorAll('.toc ol a')] as HTMLAnchorElement[];
  const sections = tocLinks
    .map((a) => document.getElementById(a.getAttribute('href')?.slice(1) ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  const currentEl = document.getElementById('toc-current');

  function setActive(id: string) {
    for (const a of tocLinks) {
      const active = a.getAttribute('href') === `#${id}`;
      a.classList.toggle('active', active);
      if (active && currentEl) currentEl.textContent = a.textContent;
    }
  }

  if (sections.length) {
    setActive(sections[0].id);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: '-8% 0px -75% 0px', threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
  }

  for (const a of tocLinks) {
    a.addEventListener('click', () => {
      if (details && !desktop.matches) details.open = false;
    });
  }
</script>

<style>
  .page {
    --gutter: 1.25rem;
    --toc-w: 270px;
    --toc-gap: 3rem;
    min-height: 100vh;
  }
  @media (max-width: 560px) {
    .page {
      --gutter: 1rem;
    }
  }

  .masthead,
  .part-nav-inner,
  .layout,
  .site-footer {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  @media (min-width: 1160px) {
    .masthead,
    .part-nav-inner,
    .layout,
    .site-footer {
      max-width: calc(var(--toc-w) + var(--toc-gap) + var(--measure) + 2 * var(--gutter));
    }
  }

  .masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--rule-strong);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .kicker {
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 700;
  }
  .kicker:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .masthead-right {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }
  .meta-link {
    color: var(--muted);
    text-decoration: none;
  }
  .meta-link:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .theme-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .t-to-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .t-to-light {
    display: inline;
  }
  :global(:root[data-theme='dark']) .t-to-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .t-to-light {
      display: inline;
    }
    :global(:root:not([data-theme='light'])) .t-to-dark {
      display: none;
    }
  }

  /* ---------- module nav strip ---------- */
  .part-nav {
    border-bottom: 1px dashed var(--rule);
    background: var(--band);
  }
  .part-nav-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    font-size: 0.8rem;
  }
  .part-tab {
    color: var(--muted);
    text-decoration: none;
    padding: 0.12rem 0.35rem;
  }
  .part-tab:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .part-tab.active {
    color: var(--accent-text);
    font-weight: 700;
    border-bottom: 2px solid var(--accent);
  }

  /* ---------- grid layout ---------- */
  @media (min-width: 1160px) {
    .layout {
      display: grid;
      grid-template-columns: var(--toc-w) minmax(0, var(--measure));
      column-gap: var(--toc-gap);
      align-items: start;
    }
  }

  /* ---------- sticky TOC ---------- */
  .toc {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter);
    background: var(--bg);
    border-bottom: 1px dashed var(--rule-strong);
    font-size: 0.82rem;
  }
  .toc summary {
    display: flex;
    gap: 0.75ch;
    padding: 0.55rem 0;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary::before {
    content: '[+]';
    color: var(--accent-text);
  }
  .toc details[open] summary::before {
    content: '[-]';
  }
  .toc-heading {
    color: var(--muted);
    text-transform: uppercase;
  }
  .toc-current {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toc-current:not(:empty)::before {
    content: '> ';
    color: var(--accent-text);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem;
    max-height: 55vh;
    overflow-y: auto;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc li.sub {
    padding-left: 1.5ch;
    font-size: 0.78rem;
  }
  .toc li a {
    display: block;
    padding: 0.14rem 0 0.14rem 3.8ch;
    text-indent: -3.8ch;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
  }
  .toc li a::before {
    content: counter(toc, decimal-leading-zero) '  ';
    white-space: pre;
    color: var(--rule-strong);
  }
  .toc li a:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .toc li a:hover::before {
    color: inherit;
  }
  .toc li a.active {
    color: var(--text);
  }
  .toc li a.active::before {
    content: '>>  ';
    color: var(--accent-text);
  }

  .toc-agent-box {
    margin-top: 0.85rem;
    padding: 0.65rem 0 0.75rem;
    border-top: 1px dashed var(--rule-strong);
    font-size: 0.78rem;
  }
  .toc-box-title {
    margin: 0 0 0.35rem;
    color: var(--accent-text);
    font-weight: 700;
  }
  .toc-agent-box ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-agent-box li {
    margin: 0.18rem 0;
  }
  .toc-agent-box a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc-agent-box a::before {
    content: '> ';
    color: var(--rule-strong);
  }
  .toc-agent-box a:hover {
    color: var(--bg);
    background: var(--accent);
  }

  @media (min-width: 1160px) {
    .toc {
      top: 0;
      margin: 0;
      padding: 2rem 0 0;
      border-bottom: 0;
      background: none;
    }
    .toc summary {
      pointer-events: none;
      padding: 0 0 0.55rem;
      margin-bottom: 0.4rem;
      border-bottom: 1px dashed var(--rule-strong);
    }
    .toc summary::before,
    .toc-current {
      display: none;
    }
    .toc ol {
      max-height: calc(100vh - 15rem);
      padding-bottom: 0;
    }
  }

  /* ---------- article typography ---------- */
  .article {
    min-width: 0;
  }
  .article-header {
    padding: 2rem 0 0.6rem;
    border-bottom: 1px dashed var(--rule-strong);
    margin-bottom: 1.5rem;
  }
  .rfc-badge {
    margin: 0 0 0.6rem !important;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  h1 {
    margin: 0 0 0.6rem;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  h1::before {
    content: '# ';
    color: var(--accent-text);
  }
  @media (max-width: 560px) {
    h1 {
      font-size: 1.35rem;
    }
  }
  .dek {
    margin: 0;
    color: var(--muted);
  }

  .article :global(h2) {
    margin: 2.4rem 0 0.8rem;
    font-size: 1.12rem;
    font-weight: 700;
  }
  .article :global(h2)::before {
    content: '## ';
    color: var(--accent-text);
  }
  .article :global(h3) {
    margin: 1.65rem 0 0.45rem;
    font-size: 0.98rem;
    font-weight: 700;
  }
  .article :global(h3)::before {
    content: '### ';
    color: var(--accent-text);
  }
  .article :global(p) {
    margin: 0 0 1.05rem;
  }
  .article :global(ul),
  .article :global(ol) {
    margin: 0 0 1.05rem;
    padding-left: 2.4ch;
  }
  .article :global(ul) {
    list-style: '- ';
  }
  .article :global(li) {
    margin: 0 0 0.5rem;
    padding-left: 0.25ch;
  }
  .article :global(li)::marker {
    color: var(--accent-text);
  }

  /* ---------- pager & CTA ---------- */
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 2.5rem 0 1.5rem;
    padding: 0.85rem 0;
    border-top: 1px dashed var(--rule-strong);
    border-bottom: 1px dashed var(--rule-strong);
    font-size: 0.88rem;
  }

  .cta {
    margin: 2.5rem 0 1rem;
    padding: 0.15rem 1.25rem 1.25rem;
    border: 1px solid var(--accent);
    background: var(--accent-tint);
  }
  .cta h2 {
    margin-top: 1rem !important;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.9rem;
  }
  .cta-button {
    display: inline-block;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--bg) !important;
    font-weight: 700;
    text-decoration: none !important;
    font-size: 0.85rem;
  }
  .cta-button:hover {
    background: transparent !important;
    color: var(--accent-text) !important;
  }
  .cta-ghost {
    display: inline-block;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule-strong);
    color: var(--text);
    text-decoration: none;
    font-size: 0.85rem;
  }
  .cta-ghost:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  /* ---------- footer ---------- */
  .site-footer {
    margin-top: 2.5rem;
    padding-top: 1rem;
    padding-bottom: 2.5rem;
    border-top: 1px dashed var(--rule-strong);
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (min-width: 1160px) {
    .site-footer > p {
      margin-left: calc(var(--toc-w) + var(--toc-gap)) !important;
    }
  }
  .site-footer p {
    margin: 0;
  }
  .site-footer p::before {
    content: '-- ';
  }
</style>
