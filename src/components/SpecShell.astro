---
import Base from '../layouts/Base.astro';
import {
  getSpecNav,
  VERSIONS,
  VERSION_LIST,
  versionSwitchUrl,
  type SpecVersionId,
  type TocItem,
  type VersionDiffBundle,
} from '../lib/spec';

interface Props {
  activeKey: string;
  version?: SpecVersionId;
  title: string;
  pageTitle?: string;
  description: string;
  pathSlug?: string;
  canonicalSlug?: string;
  rawPath?: string;
  dek?: string;
  toc: TocItem[];
  diffBundle?: VersionDiffBundle;
  prev?: { label: string; href: string };
  next?: { label: string; href: string };
}

const {
  activeKey,
  version = 'v1',
  title,
  pageTitle = `${title} — zBTC Protocol Specification`,
  description,
  pathSlug = '',
  canonicalSlug,
  rawPath = 'raw/SPEC.md',
  dek,
  toc,
  diffBundle,
  prev,
  next,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const REPO = 'https://github.com/btc-moonshot/spec';
const ISSUES = `${REPO}/issues/new/choose`;
const PRS = `${REPO}/pulls`;

const vMeta = VERSIONS[version];
const navItems = getSpecNav(version);
const isArchived = version === 'v0';
const v1PeerHref = versionSwitchUrl(activeKey, 'v1');
---

<Base
  title={pageTitle}
  description={description}
  pathSlug={pathSlug}
  canonicalSlug={canonicalSlug ?? (isArchived ? v1PeerHref.replace(base, '') : pathSlug)}
  rawPath={rawPath}
  versionLabel={vMeta.semver}
  noindex={isArchived}
>
  <div class="page">
    <header class="masthead">
      <a class="kicker" href={vMeta.routePrefix}>~/bitcoin-payments/spec</a>
      <div class="masthead-right">
        <label class="version-picker-wrap" aria-label="Specification version">
          <span class="version-picker-label">ver:</span>
          <select class="version-picker" id="version-picker" aria-label="Select specification version">
            {VERSION_LIST.map((v) => (
              <option value={versionSwitchUrl(activeKey, v.id)} selected={v.id === version}>
                {v.label}
              </option>
            ))}
          </select>
        </label>
        <a class="meta-link" href={`${base}llms.txt`}>[llms.txt]</a>
        <a class="meta-link" href={REPO} target="_blank" rel="noopener noreferrer">[github]</a>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle color theme">
          <span class="t-to-dark">[dark]</span><span class="t-to-light">[light]</span>
        </button>
      </div>
    </header>

    <nav class="part-nav" aria-label="Specification modules">
      <div class="part-nav-inner">
        {navItems.map((item) => (
          <a href={item.href} class:list={['part-tab', { active: item.key === activeKey }]}>
            {item.label}
          </a>
        ))}
      </div>
    </nav>

    <div class="layout">
      <aside class="toc" aria-label="Table of contents">
        <details open id="toc-details">
          <summary>
            <span class="toc-heading">Contents</span>
            <span class="toc-current" id="toc-current"></span>
          </summary>
          <ol>
            {toc.map((item) => (
              <li class:list={[{ sub: item.level === 3 }]}>
                <a href={`#${item.id}`}>{item.label}</a>
              </li>
            ))}
          </ol>
          <div class="toc-agent-box">
            <p class="toc-box-title">// agent, versions &amp; raw</p>
            <ul>
              <li><a href={`${base}${rawPath}`}>raw source ({rawPath.split('/').pop()})</a></li>
              <li><a href={`${base}changelog/`}>changelog (v1 vs v0)</a></li>
              <li><a href={isArchived ? v1PeerHref : versionSwitchUrl(activeKey, 'v0')}>
                {isArchived ? 'view current v1' : 'view archived v0'}
              </a></li>
              <li><a href={`${base}llms.txt`}>llms.txt (review guide)</a></li>
              <li><a href={`${base}llms-full.txt`}>llms-full.txt (1-fetch)</a></li>
              <li><a href={ISSUES} target="_blank" rel="noopener noreferrer">open finding / issue</a></li>
              <li><a href={PRS} target="_blank" rel="noopener noreferrer">submit a PR</a></li>
            </ul>
          </div>
        </details>
      </aside>

      <main class="article" id="article">
        <article>
          {isArchived && (
            <div class="archive-banner" role="note" aria-label="Archived version warning">
              <p class="archive-banner-title">
                [!] ARCHIVED VERSION: <strong>v0 ({vMeta.semver})</strong> — SUPERSEDED BY v1 (v3.0.0-rfc)
              </p>
              <p>
                This page is frozen byte-for-byte from commit <code>7b47b8c</code> (SHA-256 verified) and is
                <strong>not for implementation</strong>. Hostile review <code>R7</code> identified fatal blockers
                in <code>v0</code> (<code>C-1..C-4</code>, <code>N-1..N-6</code>) that were resolved in <code>v1</code>.
              </p>
              <p class="archive-banner-links">
                <a href={v1PeerHref}>[switch to v1]</a>
                <a href={`${v1PeerHref}?diff=1`}>[show changes v1 vs v0]</a>
                <a href={`${base}changelog/`}>[read changelog]</a>
              </p>
            </div>
          )}

          <header class="article-header">
            <div class="header-top-row">
              <p class="rfc-badge">
                {version} ({vMeta.semver}) · {isArchived ? 'archived baseline · superseded' : 'public rfc · tier f · not mainnet-active'}
              </p>
              {diffBundle && !isArchived && (
                <div class="diff-controls">
                  <button
                    type="button"
                    class="diff-toggle-btn"
                    id="diff-toggle-btn"
                    aria-pressed="false"
                  >
                    <span class="dt-show">[show changes vs v0]</span>
                    <span class="dt-hide">[hide changes · back to spec]</span>
                    <span class="dt-stats">
                      <span class="dc-add">+{diffBundle.diff.addedLines}</span>/<span class="dc-del">-{diffBundle.diff.removedLines}</span>
                    </span>
                  </button>
                  <a class="diff-changelog-link" href={`${base}changelog/`}>[changelog]</a>
                </div>
              )}
            </div>
            <h1>{title}</h1>
            {dek && <p class="dek">{dek}</p>}
          </header>

          {diffBundle && !isArchived && (
            <section class="diff-panel" id="diff-panel" hidden aria-label="Changes from v0 to v1">
              <div class="diff-panel-intro">
                <p>
                  Showing word-highlighted line changes from archived <strong>v0 (v2.5.0-rfc)</strong> to
                  <strong>v1 (v3.0.0-rfc)</strong>. For structured finding-by-finding rationale, see the
                  <a href={`${base}changelog/`}>Changelog</a>.
                </p>
              </div>
              <div set:html={diffBundle.html} />
            </section>
          )}

          <div id="spec-content-wrap">
            <slot />
          </div>

          {(prev || next) && (
            <nav class="pager" aria-label="Chapter navigation">
              <div>{prev && <a href={prev.href}>&larr; {prev.label}</a>}</div>
              <div>{next && <a href={next.href}>{next.label} &rarr;</a>}</div>
            </nav>
          )}

          <section class="cta" aria-labelledby="review-cta">
            <h2 id="review-cta">Attack this spec &amp; submit feedback</h2>
            <p>
              This is a <strong>Public RFC</strong> updated to <code>v1 (v3.0.0-rfc)</code> in response to
              Consolidated Hostile Review <code>R7</code>. Humans and AI review agents are invited to run
              <code>python3 -I scripts/verify_spec_bounds.py</code>, inspect the
              <a href={`${base}changelog/`}>v0 &rarr; v1 changelog</a>, file findings, or open pull requests.
            </p>
            <div class="cta-actions">
              <a class="cta-button" href={ISSUES} target="_blank" rel="noopener noreferrer">Open an Issue</a>
              <a class="cta-ghost" href={`${base}changelog/`}>Changelog &amp; Diffs</a>
              <a class="cta-ghost" href={`${base}review-guide/`}>Review &amp; PR Guide</a>
              <a class="cta-ghost" href={`${base}llms.txt`}>Read llms.txt</a>
            </div>
          </section>
        </article>
      </main>
    </div>

    <footer class="site-footer">
      <p>
        zBTC Interoperability Specification ({version} / {vMeta.semver}) ·
        <a href={REPO} target="_blank" rel="noopener noreferrer">github.com/btc-moonshot/spec</a> ·
        <a href={`${base}changelog/`}>changelog</a> ·
        <a href={`${base}llms.txt`}>llms.txt</a> ·
        <a href={`${vMeta.routePrefix}oracle/`}>bounds checker</a>
      </p>
    </footer>
  </div>
</Base>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  const darkQuery = matchMedia('(prefers-color-scheme: dark)');

  function currentTheme() {
    const t = root.dataset.theme;
    if (t === 'light' || t === 'dark') return t;
    return darkQuery.matches ? 'dark' : 'light';
  }

  toggle?.addEventListener('click', () => {
    const next = currentTheme() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Version dropdown navigation
  const versionPicker = document.getElementById('version-picker') as HTMLSelectElement | null;
  versionPicker?.addEventListener('change', () => {
    if (versionPicker.value) {
      window.location.href = versionPicker.value;
    }
  });

  // Inline v1 vs v0 diff toggle button (+ ?diff=1 URL support)
  const diffBtn = document.getElementById('diff-toggle-btn') as HTMLButtonElement | null;
  const diffPanel = document.getElementById('diff-panel') as HTMLElement | null;
  const specWrap = document.getElementById('spec-content-wrap') as HTMLElement | null;

  function setDiffOpen(open: boolean, updateUrl = true) {
    if (!diffBtn || !diffPanel || !specWrap) return;
    diffBtn.setAttribute('aria-pressed', open ? 'true' : 'false');
    diffBtn.classList.toggle('active', open);
    diffPanel.hidden = !open;
    specWrap.hidden = open;
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (open) url.searchParams.set('diff', '1');
      else url.searchParams.delete('diff');
      history.replaceState(null, '', url.toString());
    }
  }

  if (diffBtn && diffPanel && specWrap) {
    const params = new URLSearchParams(window.location.search);
    if (params.get('diff') === '1') {
      setDiffOpen(true, false);
    }
    diffBtn.addEventListener('click', () => {
      const isOpen = diffBtn.getAttribute('aria-pressed') === 'true';
      setDiffOpen(!isOpen, true);
    });
  }

  const details = document.getElementById('toc-details') as HTMLDetailsElement | null;
  const desktop = matchMedia('(min-width: 1160px)');
  function syncToc() {
    if (!details) return;
    details.open = desktop.matches;
  }
  syncToc();
  desktop.addEventListener('change', syncToc);

  const tocLinks = [...document.querySelectorAll('.toc ol a')] as HTMLAnchorElement[];
  const sections = tocLinks
    .map((a) => document.getElementById(a.getAttribute('href')?.slice(1) ?? ''))
    .filter((el): el is HTMLElement => el !== null);
  const currentEl = document.getElementById('toc-current');

  function setActive(id: string) {
    for (const a of tocLinks) {
      const active = a.getAttribute('href') === `#${id}`;
      a.classList.toggle('active', active);
      if (active && currentEl) currentEl.textContent = a.textContent;
    }
  }

  if (sections.length) {
    setActive(sections[0].id);
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible.length) setActive(visible[0].target.id);
      },
      { rootMargin: '-8% 0px -75% 0px', threshold: 0 }
    );
    sections.forEach((s) => observer.observe(s));
  }

  for (const a of tocLinks) {
    a.addEventListener('click', () => {
      if (details && !desktop.matches) details.open = false;
    });
  }
</script>

<style>
  .page {
    --gutter: 1.25rem;
    --toc-w: 270px;
    --toc-gap: 3rem;
    min-height: 100vh;
  }
  @media (max-width: 560px) {
    .page {
      --gutter: 1rem;
    }
  }

  .masthead,
  .part-nav-inner,
  .layout,
  .site-footer {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin: 0 auto;
    padding-inline: var(--gutter);
  }
  @media (min-width: 1160px) {
    .masthead,
    .part-nav-inner,
    .layout,
    .site-footer {
      max-width: calc(var(--toc-w) + var(--toc-gap) + var(--measure) + 2 * var(--gutter));
    }
  }

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    padding-top: 0.9rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--rule-strong);
    font-size: 0.85rem;
    color: var(--muted);
  }
  .kicker {
    color: var(--accent-text);
    text-decoration: none;
    font-weight: 700;
  }
  .kicker:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .masthead-right {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
  }
  .version-picker-wrap {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
  }
  .version-picker-label {
    color: var(--muted);
  }
  .version-picker {
    font-family: var(--font);
    font-size: 0.78rem;
    background: var(--band);
    color: var(--text);
    border: 1px solid var(--accent);
    padding: 0.14rem 0.4rem;
    cursor: pointer;
  }
  .version-picker:focus-visible {
    outline: 2px dashed var(--accent);
    outline-offset: 2px;
  }
  .meta-link {
    color: var(--muted);
    text-decoration: none;
  }
  .meta-link:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .theme-toggle {
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .t-to-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .t-to-light {
    display: inline;
  }
  :global(:root[data-theme='dark']) .t-to-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .t-to-light {
      display: inline;
    }
    :global(:root:not([data-theme='light'])) .t-to-dark {
      display: none;
    }
  }

  /* ---------- module nav strip ---------- */
  .part-nav {
    border-bottom: 1px dashed var(--rule);
    background: var(--band);
  }
  .part-nav-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
    font-size: 0.8rem;
  }
  .part-tab {
    color: var(--muted);
    text-decoration: none;
    padding: 0.12rem 0.35rem;
  }
  .part-tab:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .part-tab.active {
    color: var(--accent-text);
    font-weight: 700;
    border-bottom: 2px solid var(--accent);
  }

  /* ---------- archive banner (v0 UI-only) ---------- */
  .archive-banner {
    margin: 1.5rem 0 0;
    padding: 0.9rem 1.1rem;
    border: 2px solid var(--diff-del-text);
    background: var(--diff-del-bg);
    font-size: 0.86rem;
  }
  .archive-banner-title {
    margin: 0 0 0.45rem !important;
    color: var(--diff-del-text);
    font-weight: 700;
  }
  .archive-banner p {
    margin: 0 0 0.5rem;
  }
  .archive-banner-links {
    margin: 0.5rem 0 0 !important;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-weight: 700;
  }

  /* ---------- diff toggle button & panel ---------- */
  .header-top-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-bottom: 0.6rem;
  }
  .rfc-badge {
    margin: 0 !important;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--accent-text);
  }
  .diff-controls {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 0.78rem;
  }
  .diff-toggle-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--accent);
    background: var(--accent-tint);
    color: var(--text);
    font-family: var(--font);
    font-size: 0.78rem;
    font-weight: 700;
    cursor: pointer;
  }
  .diff-toggle-btn:hover,
  .diff-toggle-btn.active {
    background: var(--accent);
    color: var(--bg);
  }
  .diff-toggle-btn .dt-hide {
    display: none;
  }
  .diff-toggle-btn.active .dt-show {
    display: none;
  }
  .diff-toggle-btn.active .dt-hide {
    display: inline;
  }
  .diff-toggle-btn.active .dt-stats {
    display: none;
  }
  .dt-stats {
    font-weight: 400;
    font-size: 0.74rem;
  }
  .diff-changelog-link {
    color: var(--muted);
    text-decoration: none;
  }
  .diff-changelog-link:hover {
    background: var(--accent);
    color: var(--bg);
  }
  .diff-panel {
    margin-bottom: 2rem;
  }
  .diff-panel-intro {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 0.75rem;
  }

  /* ---------- grid layout ---------- */
  @media (min-width: 1160px) {
    .layout {
      display: grid;
      grid-template-columns: var(--toc-w) minmax(0, var(--measure));
      column-gap: var(--toc-gap);
      align-items: start;
    }
  }

  /* ---------- sticky TOC ---------- */
  .toc {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter);
    background: var(--bg);
    border-bottom: 1px dashed var(--rule-strong);
    font-size: 0.82rem;
  }
  .toc summary {
    display: flex;
    gap: 0.75ch;
    padding: 0.55rem 0;
    cursor: pointer;
    list-style: none;
    white-space: nowrap;
  }
  .toc summary::-webkit-details-marker {
    display: none;
  }
  .toc summary::before {
    content: '[+]';
    color: var(--accent-text);
  }
  .toc details[open] summary::before {
    content: '[-]';
  }
  .toc-heading {
    color: var(--muted);
    text-transform: uppercase;
  }
  .toc-current {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .toc-current:not(:empty)::before {
    content: '> ';
    color: var(--accent-text);
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 0.75rem;
    max-height: 55vh;
    overflow-y: auto;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
  }
  .toc li.sub {
    padding-left: 1.5ch;
    font-size: 0.78rem;
  }
  .toc li a {
    display: block;
    padding: 0.14rem 0 0.14rem 3.8ch;
    text-indent: -3.8ch;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
  }
  .toc li a::before {
    content: counter(toc, decimal-leading-zero) '  ';
    white-space: pre;
    color: var(--rule-strong);
  }
  .toc li a:hover {
    color: var(--bg);
    background: var(--accent);
  }
  .toc li a:hover::before {
    color: inherit;
  }
  .toc li a.active {
    color: var(--text);
  }
  .toc li a.active::before {
    content: '>>  ';
    color: var(--accent-text);
  }

  .toc-agent-box {
    margin-top: 0.85rem;
    padding: 0.65rem 0 0.75rem;
    border-top: 1px dashed var(--rule-strong);
    font-size: 0.78rem;
  }
  .toc-box-title {
    margin: 0 0 0.35rem;
    color: var(--accent-text);
    font-weight: 700;
  }
  .toc-agent-box ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc-agent-box li {
    margin: 0.18rem 0;
  }
  .toc-agent-box a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc-agent-box a::before {
    content: '> ';
    color: var(--rule-strong);
  }
  .toc-agent-box a:hover {
    color: var(--bg);
    background: var(--accent);
  }

  @media (min-width: 1160px) {
    .toc {
      top: 0;
      margin: 0;
      padding: 2rem 0 0;
      border-bottom: 0;
      background: none;
    }
    .toc summary {
      pointer-events: none;
      padding: 0 0 0.55rem;
      margin-bottom: 0.4rem;
      border-bottom: 1px dashed var(--rule-strong);
    }
    .toc summary::before,
    .toc-current {
      display: none;
    }
    .toc ol {
      max-height: calc(100vh - 17rem);
      padding-bottom: 0;
    }
  }

  /* ---------- article typography ---------- */
  .article {
    min-width: 0;
  }
  .article-header {
    padding: 2rem 0 0.6rem;
    border-bottom: 1px dashed var(--rule-strong);
    margin-bottom: 1.5rem;
  }
  h1 {
    margin: 0 0 0.6rem;
    font-size: 1.7rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  h1::before {
    content: '# ';
    color: var(--accent-text);
  }
  @media (max-width: 560px) {
    h1 {
      font-size: 1.35rem;
    }
  }
  .dek {
    margin: 0;
    color: var(--muted);
  }

  .article :global(h2) {
    margin: 2.4rem 0 0.8rem;
    font-size: 1.12rem;
    font-weight: 700;
  }
  .article :global(h2)::before {
    content: '## ';
    color: var(--accent-text);
  }
  .article :global(h3) {
    margin: 1.65rem 0 0.45rem;
    font-size: 0.98rem;
    font-weight: 700;
  }
  .article :global(h3)::before {
    content: '### ';
